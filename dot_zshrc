# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# -------------------------------------------------------------------
# Basic PATH / environment
# -------------------------------------------------------------------

# Default editor
export VISUAL=nvim
export EDITOR="$VISUAL"

# True color
export COLORTERM=truecolor

# -------------------------------------------------------------------
# zsh-vi-mode hook
# Important: define this before loading zsh-vi-mode.
# -------------------------------------------------------------------

function zvm_after_init() {
    source <(fzf --zsh)

    autoload -Uz edit-command-line
    zle -N edit-command-line
    bindkey -M vicmd v edit-command-line
}

# -------------------------------------------------------------------
# Antidote
# -------------------------------------------------------------------

# Plugin file root:
#   ~/.zsh_plugins.txt  -> plugin list
#   ~/.zsh_plugins.zsh  -> generated static loader
zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins

# Ensure plugin list exists
[[ -f ${zsh_plugins}.txt ]] || touch ${zsh_plugins}.txt

# Lazy-load antidote from its functions directory.
# Manual git install path:
fpath=(${ZDOTDIR:-$HOME}/.antidote/functions $fpath)

# If you installed via Homebrew instead, use this instead of the line above:
# source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh

autoload -Uz antidote

# Generate static plugin loader when it's missing/empty, or when the
# plugin list is newer. The `-s` check guards against a botched run
# leaving a 0-byte loader that the mtime test would otherwise lock in.
if [[ ! -s ${zsh_plugins}.zsh || ${zsh_plugins}.txt -nt ${zsh_plugins}.zsh ]]; then
  antidote bundle <${zsh_plugins}.txt >|${zsh_plugins}.zsh
fi

# Source generated plugin loader
source ${zsh_plugins}.zsh

# Powerlevel10k config
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# -------------------------------------------------------------------
# Completions
# -------------------------------------------------------------------
# If OMZ/lib already initialized completion correctly, this may be redundant.
# Keep it for now because your old config had it.
autoload -Uz compinit
compinit -u

# -------------------------------------------------------------------
# Aliases
# -------------------------------------------------------------------

alias nv='nvim'
alias py='python3'
alias j='z'
alias t='tmux -2'
alias lg='lazygit'
alias yz='yazi'
alias win-dev='tmuxp load win-dev'

# -------------------------------------------------------------------
# External tools
# -------------------------------------------------------------------

# lfcd
LFCD="$HOME/.local/bin/lfcd.sh"
if [[ -f "$LFCD" ]]; then
    source "$LFCD"
fi

# zoxide
eval "$(zoxide init zsh)"

# asdf version manager (Ruby 3.3 etc.)
. "$HOME/.asdf/asdf.sh"

